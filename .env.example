# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Channel IDs (Discord: User Settings -> Advanced -> Developer Mode, then right-click a channel -> Copy Channel ID)
GUILD_A_CHANNEL_ID=
GUILD_B_CHANNEL_ID=
GENERAL_CHANNEL_ID=

# Tags shown on relayed messages
GUILD_A_LABEL=A
GUILD_B_LABEL=B
GENERAL_LABEL=D

# Post into the guild sync channels (General -> game, A <-> B). Set false for one-way (game -> General only).
RELAY_INTO_GAME=true

# Log the raw shape of every message in the sync channels (to see how game messages arrive)
DISCOVER=false

# Sync-channel messages matching this regex (case-insensitive) are not relayed.
# Default drops Blizzard's "has not yet linked their Discord account" placeholder.
# SKIP_PATTERN=has not (yet )?linked their Discord account

# Max length of a message relayed into the game
GAME_MAX_LEN=255
